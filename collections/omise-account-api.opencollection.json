{
  "opencollection": "1.0.0",
  "info": {
    "name": "Omise (Opn Payments) Account API",
    "version": "2019-05-29"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.omise.co/account"
          },
          "docs": "Retrieve the account"
        },
        {
          "info": {
            "name": "Retrieve the balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.omise.co/balance"
          },
          "docs": "Retrieve the balance"
        }
      ]
    }
  ],
  "bundled": true
}