{
  "info": {
    "name": "Omise (Opn Payments) API",
    "description": "Representative, grounded subset of the Omise / Opn Payments REST API. Core API base: https://api.omise.co (secret key via HTTP Basic - key as username, empty password). Card tokenization: https://vault.omise.co (public key via HTTP Basic). Optional Omise-Version header pins the API version. Amounts are integers in the smallest currency unit. Omise rebranded to Opn Payments in 2022; hosts are unchanged.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{secretKey}}", "type": "string" },
      { "key": "password", "value": "", "type": "string" }
    ]
  },
  "variable": [
    { "key": "apiBase", "value": "https://api.omise.co", "type": "string" },
    { "key": "vaultBase", "value": "https://vault.omise.co", "type": "string" },
    { "key": "secretKey", "value": "", "type": "string" },
    { "key": "publicKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Charges",
      "item": [
        {
          "name": "Create a charge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 100000,\n  \"currency\": \"THB\",\n  \"card\": \"tokn_test_xxx\",\n  \"capture\": true\n}" },
            "url": { "raw": "{{apiBase}}/charges", "host": ["{{apiBase}}"], "path": ["charges"] },
            "description": "Creates a charge funded by a token, a saved customer card, or a source."
          }
        },
        {
          "name": "List charges",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiBase}}/charges", "host": ["{{apiBase}}"], "path": ["charges"] },
            "description": "Returns a paginated list of charges."
          }
        },
        {
          "name": "Retrieve a charge",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiBase}}/charges/:id", "host": ["{{apiBase}}"], "path": ["charges", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Returns the charge matching the id."
          }
        },
        {
          "name": "Update a charge",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated\"\n}" },
            "url": { "raw": "{{apiBase}}/charges/:id", "host": ["{{apiBase}}"], "path": ["charges", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Updates the description or metadata of a charge."
          }
        },
        {
          "name": "Capture a charge",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{apiBase}}/charges/:id/capture", "host": ["{{apiBase}}"], "path": ["charges", ":id", "capture"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Captures a previously authorized (uncaptured) charge."
          }
        },
        {
          "name": "Reverse a charge",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{apiBase}}/charges/:id/reverse", "host": ["{{apiBase}}"], "path": ["charges", ":id", "reverse"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Reverses an authorized, uncaptured charge."
          }
        },
        {
          "name": "Expire a charge",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{apiBase}}/charges/:id/expire", "host": ["{{apiBase}}"], "path": ["charges", ":id", "expire"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Expires a pending charge."
          }
        }
      ]
    },
    {
      "name": "Tokens (vault)",
      "item": [
        {
          "name": "Create a token",
          "request": {
            "method": "POST",
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{publicKey}}", "type": "string" }, { "key": "password", "value": "", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"card\": {\n    \"name\": \"Somchai\",\n    \"number\": \"4242424242424242\",\n    \"expiration_month\": 12,\n    \"expiration_year\": 2027,\n    \"security_code\": \"123\"\n  }\n}" },
            "url": { "raw": "{{vaultBase}}/tokens", "host": ["{{vaultBase}}"], "path": ["tokens"] },
            "description": "Tokenizes raw card data on the vault host using the public key. Tokens are single-use."
          }
        },
        {
          "name": "Retrieve a token",
          "request": {
            "method": "GET",
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{publicKey}}", "type": "string" }, { "key": "password", "value": "", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{vaultBase}}/tokens/:id", "host": ["{{vaultBase}}"], "path": ["tokens", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Retrieves a token by id from the vault host."
          }
        }
      ]
    },
    {
      "name": "Sources",
      "item": [
        {
          "name": "Create a source",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"promptpay\",\n  \"amount\": 100000,\n  \"currency\": \"THB\"\n}" },
            "url": { "raw": "{{apiBase}}/sources", "host": ["{{apiBase}}"], "path": ["sources"] },
            "description": "Creates a payment source for a non-card method (promptpay, truemoney, banking, installments, wallets)."
          }
        },
        {
          "name": "Retrieve a source",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiBase}}/sources/:id", "host": ["{{apiBase}}"], "path": ["sources", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Retrieves a source by id."
          }
        }
      ]
    },
