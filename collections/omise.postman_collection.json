            "description": "Returns the customer matching the id."
          }
        },
        {
          "name": "Update a customer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated\"\n}" },
            "url": { "raw": "{{apiBase}}/customers/:id", "host": ["{{apiBase}}"], "path": ["customers", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Updates a customer; pass a token in card to attach a new saved card."
          }
        },
        {
          "name": "Delete a customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{apiBase}}/customers/:id", "host": ["{{apiBase}}"], "path": ["customers", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Destroys the customer matching the id."
          }
        },
        {
          "name": "List a customer's cards",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiBase}}/customers/:id/cards", "host": ["{{apiBase}}"], "path": ["customers", ":id", "cards"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Lists the cards saved against a customer."
          }
        }
      ]
    },
